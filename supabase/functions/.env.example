# Edge function secrets: `supabase secrets set --env-file supabase/functions/.env`
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

ANTHROPIC_API_KEY=sk-ant-...
# Optional: model used for receipt extraction
CLAUDE_MODEL=claude-opus-5-5

GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Dashboard URL (OAuth callback redirects back here)
APP_URL=http://localhost:5173

# Random strings: `openssl rand -hex 32`
OAUTH_STATE_SECRET=
CRON_SECRET=
INBOUND_SECRET=

# Optional tuning
SYNC_MAX_PER_RUN=20
# New receipts per account per 24 hours from forwarding, extension, Shortcut, uploads and Claude (Gmail not counted)
DAILY_CAPTURE_LIMIT=500
# Set to false once the Postmark webhook URL uses Basic auth (https://postmark:<INBOUND_SECRET>@…)
INBOUND_ALLOW_QUERY_SECRET=true
RECEIPT_SENDERS=walmart.com,target.com,amazon.com,costco.com,homedepot.com,lowes.com,bestbuy.com,ebay.com,etsy.com,uline.com,staples.com,pirateship.com,usps.com
