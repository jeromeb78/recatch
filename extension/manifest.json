{
  "manifest_version": 3,
  "name": "Receipt Catcher",
  "version": "1.0.0",
  "description": "Import your Walmart, Target and Amazon order history \u2014 including in-store purchases \u2014 into Receipt Catcher.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Receipt Catcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.walmart.com/*",
    "https://www.target.com/*",
    "https://www.amazon.com/*",
    "https://*.supabase.co/*"
  ]
}
